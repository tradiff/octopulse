{
  "name": "octopulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:browser": "npm run build && node --test dist/test/browser.test.js",
    "replay": "npm run build && node dist/test/replay-cli.js",
    "preview": "npm run build && node dist/test/web-preview.js",
    "start": "node dist/src/daemon.js",
    "user-service:install": "npm run build && node scripts/install-user-service.mjs",
    "user-service:uninstall": "node scripts/uninstall-user-service.mjs",
    "user-service:restart": "npm run build && node scripts/deploy-user-service.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "smoke:plasma": "npm run build && node scripts/plasma-smoke.mjs",
    "check:package": "node scripts/check-package.mjs",
    "maintenance": "node dist/src/maintenance.js"
  },
  "dependencies": {
    "@jellybrick/dbus-next": "0.11.4",
    "better-sqlite3": "13.0.3",
    "markdown-it": "15.0.3",
    "parse5": "8.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
