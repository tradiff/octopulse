{
  "version": 1,
  "id": "F-01/request-cutoffs-and-equal-time-ordering",
  "requirements": ["P-21", "R-06", "A-25", "A-27"],
  "time": "2026-10-22T12:00:00Z",
  "reviewCutoff": "2026-10-22T11:00:00Z",
  "pullRequests": { "B": { "id": "B", "repository": "acme/widget", "number": 8, "title": "Review", "author": "bea" } },
  "steps": [
