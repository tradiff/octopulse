      { "source": "timeline", "id": "a-first", "kind": "review_requested", "occurredAt": "2026-10-22T11:30:00Z", "targetUser": "alex" },
      { "source": "timeline", "id": "other", "kind": "review_requested", "occurredAt": "2026-10-22T11:40:00Z", "targetUser": "cam" },
      { "source": "timeline", "id": "self", "kind": "review_requested", "occurredAt": "2026-10-22T11:50:00Z", "targetUser": "alex", "actor": { "login": "Alex" } }
    ] },
    { "action": "restart" },
    { "action": "observe", "pr": "B", "events": [
      { "source": "timeline", "id": "a-first", "kind": "review_requested", "occurredAt": "2026-10-22T11:30:00Z", "targetUser": "alex" },
      { "source": "timeline", "id": "z-last", "kind": "review_requested", "occurredAt": "2026-10-22T11:30:00Z", "targetUser": "alex" }
