        { "key": "timeline:z-last", "decision": "eligible" },
        { "key": "timeline:other", "decision": "review_request_ineligible" }, { "key": "timeline:self", "decision": "self" }
      ] } },
      "notifications": [{ "events": ["timeline:after"], "status": "sent" }, { "events": ["timeline:z-last"], "status": "sent" }],
      "submissions": [{}, {}]
    } }
  ]
